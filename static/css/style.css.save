:root {
    --bg: #0f172a;
    --card-bg: #1e293b;
    --text-primary: #f8fafc;
    --text-secondary: #94a3b8;
    --accent: #38bdf8;
    --status-normal: #22c55e;
    --status-warning: #eab308;
    --status-critical: #ef4444;
}

body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    background-color: var(--bg);
    color: var(--text-primary);
    margin: 0;
    padding: 24px;
}

.container {
    max-width: 960px;
    margin: 0 auto;
}

header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid #334155;
    padding-bottom: 16px;
    margin-bottom: 24px;
    flex-wrap: wrap;
    gap: 16px;
}

h1 {
    font-size: 1.5rem;
    margin: 0 0 4px 0;
}

p {
    color: var(--text-secondary);
    margin: 0;
}

button {
    background: var(--accent);
    color: #0f172a;
    font-weight: 600;
    border: none;
    padding: 10px 18px;
    border-radius: 6px;
    cursor: pointer;
    transition: opacity 0.2s;
}

button:hover {
    opacity: 0.9;
}

.grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
}

.card {
    background-color: var(--card-bg);
    border-radius: 8px;
    padding: 20px;
    border: 1px solid #334155;
}

.card h2 {
    font-size: 1.1rem;
    color: var(--text-secondary);
    margin-top: 0;
}

.metric {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-bottom: 12px;
}

.metric .value {
    font-size: 2.2rem;
    font-weight: 700;
}

.progress-bar {
    width: 100%;
    height: 10px;
    background-color: #334155;
    border-radius: 5px;
    overflow: hidden;
    margin-bottom: 12px;
}

.progress-bar .fill {
    height: 100%;
    transition: width 0.4s ease, background-color 0.4s ease;
}

.level-normal { background-color: var(--status-normal) !important; color: var(--status-normal); }
.level-warning { background-color: var(--status-warning) !important; color: var(--status-warning); }
.level-critical { background-color: var(--status-critical) !important; color: var(--status-critical); }

.sub-metric {
    font-size: 0.9rem;
    color: var(--text-secondary);
}
.fill.level-normal { background-color: var(--status-normal); }
.fill.level-warning { background-color: var(--status-warning); }
.fill.level-critical { background-color: var(--status-critical); }
